{
  "expo": {
    "name": "Encúmbrate",
    "slug": "encumbrate-app",
    "owner": "encumbrate-apps-team",
    "scheme": "encumbrate",
    "version": "0.1.5",
    "icon": "../public/icon-512-v2.jpg",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "es.encumbrate.app",
      "buildNumber": "5",
      "icon": "../public/icon-512-v2.jpg",
      "infoPlist": {
        "UIBackgroundModes": ["location"],
        "NSLocationWhenInUseUsageDescription": "Encúmbrate usa tu ubicación para mostrarte sobre el sendero.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Encúmbrate guarda tu recorrido con la pantalla apagada para ayudarte a seguir y recuperar el sendero."
      }
    },
    "android": {
      "package": "es.encumbrate.app",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "../public/icon-512-v2.jpg",
        "backgroundColor": "#063f2d"
      }
    },
    "splash": {
      "image": "../public/icon-512-v2.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#063f2d"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permite que Encúmbrate registre tu ruta con la pantalla apagada.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b9db7025-6732-4e17-b975-6e7484ae7545"
      }
    }
  }
}
